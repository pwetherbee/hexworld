{
  "$defs": {
    "Attempt": {
      "properties": {
        "run_id": {
          "type": "string"
        },
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        },
        "attempt": {
          "type": "integer"
        },
        "directive": {
          "$ref": "#/$defs/Directive"
        },
        "design": {
          "anyOf": [
            {
              "$ref": "#/$defs/TileDesign"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation": {
          "additionalProperties": true,
          "type": "object"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "default": "pending",
          "enum": [
            "pending",
            "invalid",
            "rejected",
            "accepted",
            "error"
          ],
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "type": "number"
        }
      },
      "required": [
        "run_id",
        "q",
        "r",
        "attempt",
        "directive",
        "design",
        "asset_id",
        "validation",
        "verdict",
        "outcome",
        "error",
        "created_at"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "AttributeDef": {
      "description": "One attribute tile agents may set. The super defines these; we compile them to JSON Schema.\n\nThis *is* the restricted meta-schema: the super can't emit arbitrary JSON Schema, only\ntyped, bounded attributes, so the compiled schema is always valid for strict structured\noutput and for jsonschema validation.",
      "properties": {
        "name": {
          "description": "snake_case identifier",
          "type": "string"
        },
        "type": {
          "enum": [
            "enum",
            "enum_list",
            "integer",
            "number",
            "boolean",
            "string"
          ],
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enum_values": {
          "description": "Allowed values for enum / enum_list types; empty otherwise.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lower bound for integer/number; null otherwise."
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Upper bound for integer/number; null otherwise."
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "enum_values",
        "minimum",
        "maximum"
      ],
      "title": "AttributeDef",
      "type": "object"
    },
    "Coord": {
      "properties": {
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        }
      },
      "required": [
        "q",
        "r"
      ],
      "title": "Coord",
      "type": "object"
    },
    "CopySpec": {
      "description": "Lets the super reuse a tile instead of generating a new one (cheap filler: open sea, plain\ndesert...). The source must be a non-copy tile in this plan or an accepted tile in the world.\n\n- shallow: a linked instance. The copy shares the prototype's art and data, and stays in sync if\n  the prototype changes later.\n- deep: an independent snapshot. The copy gets its own record at copy time and never changes\n  when the prototype does. `copy_of` is kept only as provenance.",
      "properties": {
        "mode": {
          "description": "'none' = generate this tile normally.",
          "enum": [
            "none",
            "shallow",
            "deep"
          ],
          "type": "string"
        },
        "source_q": {
          "description": "Prototype tile q (ignored when mode is 'none').",
          "type": "integer"
        },
        "source_r": {
          "description": "Prototype tile r (ignored when mode is 'none').",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "source_q",
        "source_r"
      ],
      "title": "CopySpec",
      "type": "object"
    },
    "CreateWorld": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "radius": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CreateWorld",
      "type": "object",
      "required": [
        "name",
        "radius"
      ]
    },
    "DecalPixel": {
      "properties": {
        "dx": {
          "type": "integer"
        },
        "dy": {
          "type": "integer"
        },
        "tone": {
          "enum": [
            "outline",
            "dark",
            "base",
            "light",
            "hi",
            "accent"
          ],
          "type": "string"
        }
      },
      "required": [
        "dx",
        "dy",
        "tone"
      ],
      "title": "DecalPixel",
      "type": "object"
    },
    "Directive": {
      "description": "What the super asks of one tile agent (derived from a PlannedTile, plus retry feedback).",
      "properties": {
        "coord": {
          "$ref": "#/$defs/Coord"
        },
        "biome": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edge_hints": {
          "items": {
            "$ref": "#/$defs/EdgeHint"
          },
          "type": "array"
        },
        "feedback": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "simplified": {
          "default": false,
          "type": "boolean"
        },
        "duplicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CopySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "coord",
        "biome",
        "intent",
        "features",
        "edge_hints",
        "feedback",
        "simplified",
        "duplicate"
      ],
      "title": "Directive",
      "type": "object"
    },
    "EdgeHint": {
      "properties": {
        "edge": {
          "description": "Edge index 0..5 (0 E, 1 NE, 2 NW, 3 W, 4 SW, 5 SE).",
          "type": "integer"
        },
        "terrain": {
          "type": "string"
        },
        "connectors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "edge",
        "terrain",
        "connectors"
      ],
      "title": "EdgeHint",
      "type": "object"
    },
    "EdgeSpec": {
      "properties": {
        "terrain": {
          "description": "Terrain along this edge; one of the world's terrain_vocabulary.",
          "type": "string"
        },
        "connectors": {
          "description": "Connectors crossing this edge (subset of connector_vocabulary).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "terrain",
        "connectors"
      ],
      "title": "EdgeSpec",
      "type": "object"
    },
    "Event": {
      "properties": {
        "id": {
          "default": 0,
          "type": "integer"
        },
        "ts": {
          "type": "number"
        },
        "world_id": {
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "q": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "r": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "id",
        "ts",
        "world_id",
        "run_id",
        "type",
        "span_id",
        "parent_span_id",
        "q",
        "r",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "HeightOp": {
      "description": "Relief pattern, evaluated per BLOCK in world space: selected blocks are raised/lowered by\n`delta` levels (one level = one pixel-cube high).",
      "properties": {
        "op": {
          "enum": [
            "patches",
            "cellfill",
            "stripes",
            "speckle"
          ],
          "type": "string"
        },
        "scale": {
          "description": "Feature size in pixels (8-48 for block-scale relief).",
          "type": "number"
        },
        "amount": {
          "description": "0-1 coverage/density.",
          "type": "number"
        },
        "delta": {
          "description": "-2..+4 levels added to selected blocks.",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "scale",
        "amount",
        "delta"
      ],
      "title": "HeightOp",
      "type": "object"
    },
    "MaterialSpec": {
      "properties": {
        "base_color": {
          "description": "'#rrggbb'. A 5-step ramp (outline/dark/base/light/hi) is derived.",
          "type": "string"
        },
        "accent_color": {
          "description": "'#rrggbb' for accent decals (flowers, embers, sparkles).",
          "type": "string"
        },
        "base_tone": {
          "enum": [
            "dark",
            "base",
            "light"
          ],
          "type": "string"
        },
        "liquid": {
          "type": "boolean"
        },
        "rank": {
          "description": "0-9 height rank; higher materials get a dark lip where they meet lower ones.",
          "type": "integer"
        },
        "boundary": {
          "description": "How this material's own border pixels look: foam (water), glow (lava), lip, none.",
          "enum": [
            "lip",
            "foam",
            "glow",
            "none"
          ],
          "type": "string"
        },
        "block_style": {
          "default": "bevel",
          "description": "How each 8px block is drawn: 'bevel' (lit top-left, shaded bottom-right; stone, dirt, grass, obsidian), 'outline' (dark 1px frame: bricks, planks, tiles), 'flat' (liquids, snow, sand).",
          "enum": [
            "bevel",
            "outline",
            "flat"
          ],
          "type": "string"
        },
        "height": {
          "default": 1,
          "description": "Base relief level 0-4 (liquids 0, plains 1, hills 2, rock 3+).",
          "type": "integer"
        },
        "height_ops": {
          "description": "Relief patterns (<= 3), e.g. ridges.",
          "items": {
            "$ref": "#/$defs/HeightOp"
          },
          "type": "array"
        },
        "ops": {
          "description": "Pattern layers in paint order (<= 8).",
          "items": {
            "$ref": "#/$defs/PatternOp"
          },
          "type": "array"
        },
        "scatter": {
          "description": "Ambient sprites for tiles of this material (<= 2 kinds).",
          "items": {
            "$ref": "#/$defs/ScatterSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "base_color",
        "accent_color",
        "base_tone",
        "liquid",
        "rank",
        "boundary",
        "block_style",
        "height",
        "height_ops",
        "ops",
        "scatter"
      ],
      "title": "MaterialSpec",
      "type": "object"
    },
    "PatternOp": {
      "description": "One layer of a material, evaluated in world pixel coordinates (seamless across tiles).\n\npatches:  smooth noise blobs, coverage = amount       stripes: waves at `angle`, period = scale\nspeckle:  random single pixels, density = amount      cells:   voronoi cracks/mortar, width ~ amount\ncellfill: fill a fraction (amount) of voronoi cells    bevel:   per-cell light/dark bevel (stones)\ndecals:   stamp `pixels` on a jittered grid (cell = scale, density = amount)",
      "properties": {
        "op": {
          "enum": [
            "patches",
            "speckle",
            "stripes",
            "cells",
            "cellfill",
            "bevel",
            "decals"
          ],
          "type": "string"
        },
        "tone": {
          "enum": [
            "outline",
            "dark",
            "base",
            "light",
            "hi",
            "accent"
          ],
          "type": "string"
        },
        "scale": {
          "description": "Feature size in pixels (2-16).",
          "type": "number"
        },
        "amount": {
          "description": "0-1 coverage/density/width, per op.",
          "type": "number"
        },
        "angle": {
          "description": "Degrees, for stripes.",
          "type": "number"
        },
        "pixels": {
          "description": "Decal pattern (for 'decals'); [] otherwise.",
          "items": {
            "$ref": "#/$defs/DecalPixel"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "tone",
        "scale",
        "amount",
        "angle",
        "pixels"
      ],
      "title": "PatternOp",
      "type": "object"
    },
    "PlannedTile": {
      "properties": {
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        },
        "leave_empty": {
          "description": "True to deliberately leave this slot empty.",
          "type": "boolean"
        },
        "biome": {
          "description": "Dominant terrain, from terrain_vocabulary.",
          "type": "string"
        },
        "intent": {
          "description": "One sentence: what this tile is and its role in the world.",
          "type": "string"
        },
        "features": {
          "description": "Notable features/props, e.g. 'ruined tower', 'pine trees'.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edge_hints": {
          "description": "Edge constraints the super wants (may be partial).",
          "items": {
            "$ref": "#/$defs/EdgeHint"
          },
          "type": "array"
        },
        "priority": {
          "description": "1 (low) .. 5 (high); higher is generated earlier within its wave.",
          "type": "integer"
        },
        "duplicate": {
          "$ref": "#/$defs/CopySpec",
          "description": "Copy another tile instead of generating (mode 'none' to generate)."
        }
      },
      "required": [
        "q",
        "r",
        "leave_empty",
        "biome",
        "intent",
        "features",
        "edge_hints",
        "priority",
        "duplicate"
      ],
      "title": "PlannedTile",
      "type": "object"
    },
    "PropSpec": {
      "description": "A sprite standing on the tile (tree, castle, campfire...). Rendered as its own layer.",
      "properties": {
        "kind": {
          "description": "What it is, e.g. 'castle', 'pine tree', 'campfire', 'dark obelisk'.",
          "type": "string"
        },
        "x": {
          "description": "-0.6 (west) .. 0.6 (east), tile-local.",
          "type": "number"
        },
        "y": {
          "description": "-0.6 (north) .. 0.6 (south), tile-local.",
          "type": "number"
        },
        "scale": {
          "description": "0.6 .. 1.6 relative size.",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "scale"
      ],
      "title": "PropSpec",
      "type": "object"
    },
    "Run": {
      "properties": {
        "id": {
          "type": "string"
        },
        "world_id": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Coord"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/RunOptions"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "pending"
        },
        "created_at": {
          "type": "number"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stats": {
          "$ref": "#/$defs/RunStats"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "world_id",
        "origin",
        "prompt",
        "options",
        "status",
        "created_at",
        "finished_at",
        "error",
        "stats",
        "plan"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunOptions": {
      "properties": {
        "radius": {
          "default": 5,
          "description": "How far from the clicked tile the super may expand.",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "review_batch": {
          "default": 12,
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "max_llm_calls": {
          "default": 1500,
          "minimum": 1,
          "type": "integer"
        },
        "max_cost_usd": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_seconds": {
          "default": 2400,
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "title": "RunOptions",
      "type": "object",
      "required": [
        "radius",
        "max_attempts",
        "review_batch",
        "max_llm_calls",
        "max_cost_usd",
        "max_seconds"
      ]
    },
    "RunStats": {
      "properties": {
        "llm_calls": {
          "default": 0,
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "type": "number"
        },
        "images": {
          "default": 0,
          "type": "integer"
        },
        "tiles_planned": {
          "default": 0,
          "type": "integer"
        },
        "tiles_accepted": {
          "default": 0,
          "type": "integer"
        },
        "tiles_failed": {
          "default": 0,
          "type": "integer"
        },
        "tiles_copied": {
          "default": 0,
          "type": "integer"
        },
        "copy_fallbacks": {
          "default": 0,
          "type": "integer"
        },
        "attempts": {
          "default": 0,
          "type": "integer"
        },
        "rejections_validation": {
          "default": 0,
          "type": "integer"
        },
        "rejections_review": {
          "default": 0,
          "type": "integer"
        }
      },
      "title": "RunStats",
      "type": "object",
      "required": [
        "llm_calls",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "cost_usd",
        "images",
        "tiles_planned",
        "tiles_accepted",
        "tiles_failed",
        "tiles_copied",
        "copy_fallbacks",
        "attempts",
        "rejections_validation",
        "rejections_review"
      ]
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ScatterSpec": {
      "properties": {
        "kind": {
          "description": "Sprite kind placed around this material, e.g. 'oak tree', 'boulder'.",
          "type": "string"
        },
        "count": {
          "description": "Sprites per tile of this material (0-8).",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "ScatterSpec",
      "type": "object"
    },
    "Scores": {
      "properties": {
        "style": {
          "description": "1-5 consistency with the style guide and anchor tile",
          "type": "integer"
        },
        "fidelity": {
          "description": "1-5 visual quality / readability",
          "type": "integer"
        },
        "edge_continuity": {
          "description": "1-5 how well edges continue into accepted neighbors",
          "type": "integer"
        },
        "directive_fit": {
          "description": "1-5 how well it matches its directive",
          "type": "integer"
        }
      },
      "required": [
        "style",
        "fidelity",
        "edge_continuity",
        "directive_fit"
      ],
      "title": "Scores",
      "type": "object"
    },
    "ShapeOp": {
      "description": "One primitive on the sprite canvas (pixel units, origin top-left).\n\nrect: top-left (x, y), size (w, h) | ellipse: center (x, y), radii (w, h)\ntri: apex (x, y), base at y+h, half-width w | line: (x, y) -> (x+w, y+h) | pixel: (x, y)",
      "properties": {
        "op": {
          "enum": [
            "rect",
            "ellipse",
            "tri",
            "line",
            "pixel"
          ],
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "color": {
          "description": "Index into the program's colors.",
          "type": "integer"
        },
        "tone": {
          "description": "Ramp step of that color.",
          "enum": [
            "outline",
            "dark",
            "base",
            "light",
            "hi"
          ],
          "type": "string"
        },
        "shade": {
