# Copy to .env at the repo root.

# --- LLM: openai | replay  (fake = test double for the pytest suite only)
HEXWORLD_LLM=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=
HEXWORLD_SUPER_MODEL=gpt-6-luna
HEXWORLD_TILE_MODEL=gpt-6-luna
HEXWORLD_ARTIST_MODEL=gpt-6-luna
# reasoning effort per role ("" = model default)
HEXWORLD_SUPER_REASONING=low
HEXWORLD_TILE_REASONING=low
HEXWORLD_ARTIST_REASONING=low
# store every real LLM response so runs can be replayed for free (HEXWORLD_LLM=replay)
HEXWORLD_RECORD_LLM=true

# --- Ground renderer: procedural (agent-designed materials) | comfyui | openai
HEXWORLD_IMAGE=procedural
HEXWORLD_IMAGE_FALLBACK=procedural
HEXWORLD_COMFYUI_URL=http://127.0.0.1:8188
HEXWORLD_OPENAI_IMAGE_MODEL=gpt-image-1

# --- Concurrency / quality gates
HEXWORLD_LLM_CONCURRENCY=8
HEXWORLD_IMAGE_CONCURRENCY=2
HEXWORLD_MAX_SEAM_DELTA=0.35
