# Copy to .env at the repo root. Everything defaults to a fully offline setup (fake LLM + procedural stub art).

# --- LLM: fake | openai | replay
HEXWORLD_LLM=fake
OPENAI_API_KEY=
# OPENAI_BASE_URL=
HEXWORLD_SUPER_MODEL=gpt-5
HEXWORLD_TILE_MODEL=gpt-5-mini
# reasoning effort per role ("" = model default)
HEXWORLD_SUPER_REASONING=low
HEXWORLD_TILE_REASONING=minimal
# store every real LLM response so runs can be replayed for free (HEXWORLD_LLM=replay)
HEXWORLD_RECORD_LLM=true

# --- Images: stub | comfyui | openai ; fallback when the primary fails: none | stub | openai
HEXWORLD_IMAGE=stub
HEXWORLD_IMAGE_FALLBACK=stub
HEXWORLD_COMFYUI_URL=http://127.0.0.1:8188
HEXWORLD_OPENAI_IMAGE_MODEL=gpt-image-1

# --- Concurrency / quality gates
HEXWORLD_LLM_CONCURRENCY=8
HEXWORLD_IMAGE_CONCURRENCY=2
HEXWORLD_MAX_SEAM_DELTA=0.35
